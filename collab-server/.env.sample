# Base URL of the Django API (no trailing slash needed)
DJANGO_API_URL=http://localhost:8000/api
# Must exactly match backend's DJANGO_SECRET_KEY (backend/.env.sample) -
# used to verify ninja-jwt access tokens locally.
# Quote the value if it contains #, $, or other shell-special characters -
# Node's dotenv (unlike Python's decouple) truncates unquoted values at #.
DJANGO_SECRET_KEY="django-insecure-&kb*dfba9cjg49w_lo$s#ytsfn92e1y=%vty21m*ikc4&i2n!="
PORT=1234
